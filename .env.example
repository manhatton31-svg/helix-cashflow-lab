# --- Free mock (default) ---
# Leave HELIX_USE_GROK unset so unpaid visitors never hit xAI.

# --- Paid Grok path (Vercel / production) ---
# HELIX_USE_GROK=1
# XAI_API_KEY=
# XAI_MODEL=grok-4-latest

# --- Whop checkout hook (do not invent a URL) ---
# Paste the live Whop checkout when it exists. Empty = disabled "Get access" button.
# WHOP_CHECKOUT_URL=
# WHOP_PLAN_ID=

# --- After-pay unlock ---
# Set a long random string. Point Whop's success/redirect URL at:
#   https://helix-cashflow-lab.vercel.app/generator?access=<HELIX_ACCESS_TOKEN>
# HELIX_ACCESS_TOKEN=
